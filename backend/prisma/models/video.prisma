enum VideoStatus {
  PENDING_UPLOAD
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum VideoVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model Video {
  id           String  @id
  title        String
  description  String?
  objectKey    String? @unique
  thumbnailKey String?

  status     VideoStatus     @default(PENDING_UPLOAD)
  visibility VideoVisibility @default(PRIVATE)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
